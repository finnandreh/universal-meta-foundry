{
  "manifest_version": 1,
  "id": "quick-kitchen-inventory-soul",
  "name": "Quick Kitchen Inventory",
  "project_role": "ready_system",
  "project_type": "web_tracker",
  "purpose": "Track pantry and fridge items with simple add/use/low-stock status so shopping decisions are fast.",
  "operating_model": {
    "mode": "single_user_local_first",
    "template_intelligence": {
      "always_check_on_specify": true,
      "evaluate_for_template_promotion_on_start": true,
      "reuse_sources": [
        "project_history",
        "sibling_systems",
        "shared_templates"
      ]
    },
    "workflow": [
      "add_item",
      "update_quantity",
      "mark_low_stock",
      "review_shopping_list"
    ],
    "primary_entities": [
      "item",
      "category",
      "shopping_flag"
    ]
  },
  "instruction_scope": {
    "copilot_scope": "this_project_only",
    "in_scope": [
      "frontend_form_and_list_ui",
      "simple_crud_api",
      "local_json_export_import",
      "basic_low_stock_rules"
    ],
    "out_of_scope": [
      "multi_tenant_auth",
      "payment_flows",
      "cloud_infrastructure_automation"
    ]
  },
  "starter_defaults": {
    "categories": [
      "Pantry",
      "Fridge",
      "Freezer",
      "Spices"
    ],
    "low_stock_threshold": 2,
    "status_values": [
      "ok",
      "low",
      "out"
    ]
  },
  "template_governance": {
    "template_archive_ref": "shared/templates/template_archive_index.json",
    "project_template_bindings": [
      {
        "template_id": "soul.identity.template",
        "template_version": "1.0.0",
        "compatibility_mode": "backward_compatible"
      }
    ],
    "upgrade_policy": {
      "adopt_better_template_when_found": true,
      "require_backward_compat_notes": true,
      "require_migration_notes": true
    }
  },
  "project_lifecycle": {
    "allowed_statuses": [
      "planned",
      "active",
      "paused",
      "done"
    ],
    "current_status": "active",
    "current_working_on": "Implement and refine the simple project intake and status management flow.",
    "completed": [
      "Created kitchen inventory identity baseline",
      "Defined starter defaults and inventory status values"
    ],
    "next_up": [
      "Keep GUI and status settings aligned",
      "Promote active work to done when validated"
    ],
    "last_updated": "2026-03-12"
  },
  "created_at": "2026-03-12"
}
